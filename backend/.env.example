# Variables de entorno opcionales. Copia este archivo como .env (no se sube a GitHub).
# Base de datos MySQL (valores de desarrollo)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=integratel_app
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_DB=integratel_reclamos
# Correo real (si se omite, los correos se guardan como .eml en backend/sent_emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Integratel Peru - Reclamos
